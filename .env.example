# copy to .env and edit, then: docker compose up -d

# host port the router listens on (container always listens on 3000)
HTTP_PORT=80

# host interface to bind that port to. set to 127.0.0.1 when something else terminates
# tls in front of it (the https profile below, or a cloudflare tunnel)
HTTP_BIND_IP=0.0.0.0

# debug namespace filter, set to pkc-http-router:* to enable debug + http request logs
DEBUG=

# set to 1 to skip multiaddr/ip validation, testing only
NO_IP_VALIDATE=

# set to 0 to stop verifying the ipip-0526 signature of announced records, only safe when
# the router is not reachable by untrusted clients
VERIFY_SIGNATURES=

# when set, per-request provider logs are written to log/<LOG_KEY> and served at GET /log
LOG_KEY=

# --- https profile only (docker compose --profile https up -d) ---

# domain the cert is issued for, must be on a cloudflare zone
DOMAIN=
# email let's encrypt sends expiry notices to
CERT_EMAIL=
# cloudflare api token with Zone:DNS:Edit on that zone, used for the dns-01 challenge
CLOUDFLARE_API_TOKEN=
# host port nginx serves https on
HTTPS_PORT=443
